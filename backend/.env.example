# Subvocal Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Settings are read by app/config.py (pydantic-settings).

# --- LLM (required — no defaults; server will fail to start without these) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# --- Application ---
# DEBUG=true

# --- CORS (JSON list) ---
# DEFAULT: ["http://localhost:5173", "tauri://localhost"]
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "tauri://localhost"]