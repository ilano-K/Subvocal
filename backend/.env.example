# Subvocal Backend: environment variables
# Copy this file to .env to change a setting. Every value is optional.
# Settings are read by app/config.py (pydantic-settings).

# --- Default AI model (optional) ---
# The app lets you add providers and API keys in Settings > AI models, and that is the
# easiest way. Fill these in only if you want a fallback model that is used when no model
# is chosen in Settings. Any OpenAI-compatible endpoint works.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Natural voice (optional) ---
# Set to false while developing: skips loading the voice every time the server reloads.
# TTS_AUTOLOAD=true
# CPU threads the voice may use (default: all but one core).
# TTS_THREADS=4
# Maximum size of the saved audio, in MB.
# TTS_CACHE_MAX_MB=2048

# --- Application ---
# DEBUG=true

# --- CORS (JSON list) ---
# DEFAULT: ["http://localhost:5173", "tauri://localhost", "http://tauri.localhost", "https://tauri.localhost"]
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "tauri://localhost", "http://tauri.localhost", "https://tauri.localhost"]
